# Copy to .env and fill in. .env is gitignored — NEVER commit real values.
# Rotate any credential that has been pasted into a chat, ticket, or email.

# --- Shopify app (Partner Dashboard → your app → Client credentials) -------
# Client ID is public — it appears in every OAuth redirect. The secret is not.
# All three must be set or the install routes stay disabled (503) rather than
# half-working.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Comma-separated. Keep minimal — unused scopes slow app review.
# read_orders needs Shopify's protected customer data approval; not yet used.
SHOPIFY_SCOPES=read_products

# Public HTTPS origin Shopify redirects back to. MUST be https.
# Local dev:  cloudflared tunnel --url http://localhost:8787
# Must match application_url and redirect_urls in shopify.app.toml exactly.
SHOPIFY_APP_URL=

# --- Development store ----------------------------------------------------
# Needed to resolve Phase 0 OPEN-QUESTION #1 (meta.ucp-agent.profile encoding).
# The UCP catalog/cart tools are UNAUTHENTICATED — only this domain is required.
DEV_SHOP_DOMAIN=your-dev-store.myshopify.com

# Our published UCP agent profile URI, sent as meta['ucp-agent.profile'].
AGENT_PROFILE=https://storeagent.dev/ucp-profile.json

# --- Model provider (OpenAI) ----------------------------------------------
# Needed to verify the orchestrator against a live model.
OPENAI_API_KEY=
# OPENAI_ORG=

# Tier -> model id. Defaults live in src/model.ts but are UNVERIFIED —
# confirm against GET /v1/models and pin them here.
MODEL_CLASSIFY=
MODEL_WORKHORSE=
MODEL_ESCALATION=

# --- Deployment (see docs/DEPLOY.md) --------------------------------------
# Turns on startup validation: the gateway refuses to boot rather than run
# misconfigured in front of merchants.
# NODE_ENV=production

PORT=8787

# SQLite file holding installs, settings, sessions and the attribution
# experiment. In production this MUST be on a mounted volume — on a container's
# ephemeral disk every merchant is logged out by the next deploy, and the
# experiment (which cannot be reconstructed) is destroyed.
STOREAGENT_DB=./storeagent.db

# Comma-separated storefront origins allowed to call the gateway.
# "*" is rejected in production: it would let any website drive a merchant's
# assistant and bill them for the tokens.
ALLOWED_ORIGINS=*

# --- Rate limiting & spend ceilings ---------------------------------------
# Required in production. ALLOWED_ORIGINS is enforced by the browser, so it
# does not stop a script calling /api/chat directly; without these the first
# signal of abuse is the invoice.
RATE_LIMIT_ENABLED=true

# Number of reverse proxies between the internet and this process.
#   0 = exposed directly (default; ignores X-Forwarded-For, which is forgeable)
#   1 = behind one proxy, e.g. Coolify/Traefik, Caddy, nginx
#   2 = behind Cloudflare AND a proxy
# Too low behind a proxy: every request looks like it comes from the proxy, so
# all shoppers share one bucket and throttle each other.
# Too high: the limiter reads an attacker-supplied value and stops working.
TRUST_PROXY_HOPS=0

# Per-client token bucket. A chat turn costs 5 tokens, so burst 60 / refill 60
# allows a 12-message flurry and 12/min sustained.
RATE_LIMIT_BURST=60
RATE_LIMIT_REFILL_PER_MIN=60

# Daily spend ceilings, in units (1 chat turn = 1, TTS = 0.5). These bound the
# bill; the bucket only bounds the rate. Persisted, so a crash loop cannot
# reset them.
DAILY_UNITS_PER_SHOP=5000
DAILY_UNITS_GLOBAL=50000

# --- Billing --------------------------------------------------------------
# Create Shopify subscriptions as TEST charges. Required explicitly in
# production, because both mistakes are silent:
#   true  in production -> merchants subscribe and you are NEVER PAID
#   false while testing -> real cards are charged
# Use true against a development store; false only when you mean to bill.
SHOPIFY_BILLING_TEST=true

# --- Webhooks -------------------------------------------------------------
# HMAC verification secret for Shopify webhooks (orders/create, app/uninstalled,
# shop/redact, customers/redact).
SHOPIFY_WEBHOOK_SECRET=
