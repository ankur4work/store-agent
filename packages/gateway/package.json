    "start": "node dist/src/main.js",
    "dev": "npm run build && node dist/src/main.js"
  },
  "dependencies": {
    "@storeagent/attribution": "*",
    "@storeagent/billing": "*",
    "@storeagent/grounding": "*",
    "@storeagent/orchestrator": "*",
    "@storeagent/resilience": "*",
    "@storeagent/ucp-client": "*",
    "@storeagent/voice": "*"
  }
}
