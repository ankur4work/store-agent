{
  "name": "@storeagent/grounding",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "_comment": "rootDir is the package root so tests are typechecked too, hence dist/src/.",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": "./dist/src/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  }
}
