{
  "name": "storeagent",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "bench": "npm run bench --workspace @storeagent/ucp-client",
    "build": "tsc --build",
    "check-all": "npm run build && node scripts/check-secrets.mjs --all && node scripts/check-deploy.mjs && node scripts/check-limits.mjs && node scripts/check-billing.mjs && node scripts/check-observability.mjs && node scripts/check-launch.mjs",
    "check-billing": "npm run build && node scripts/check-billing.mjs",
    "check-deploy": "npm run build && node scripts/check-deploy.mjs",
    "check-launch": "npm run build && node scripts/check-launch.mjs",
    "check-limits": "npm run build && node scripts/check-limits.mjs",
    "check-observability": "npm run build && node scripts/check-observability.mjs",
    "check-secrets": "node scripts/check-secrets.mjs",
    "check-secrets:all": "node scripts/check-secrets.mjs --all",
    "clean": "tsc --build --clean",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "tsc --build"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
