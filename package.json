{
  "name": "storeagent",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "tsc --build",
    "clean": "tsc --build --clean",
    "check-secrets": "node scripts/check-secrets.mjs",
    "check-secrets:all": "node scripts/check-secrets.mjs --all",
    "bench": "npm run bench --workspace @storeagent/ucp-client"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
