# Normalize all text to LF in the repository, regardless of contributor OS.
# Keeps diffs clean between Windows dev machines and Linux CI.
* text=auto eol=lf

# Binary — never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.woff binary
*.woff2 binary
*.mp3 binary
*.wav binary
*.pdf binary

# Generated — collapse in diffs and exclude from language stats.
package-lock.json linguist-generated=true -diff
